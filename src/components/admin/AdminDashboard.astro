---
import styles from './AdminDashboard.module.css';
import Button from '../Button.astro';
import Badge from '../Badge.astro';
import { contentRepository } from '../../repositories/content.repository';

interface Props {
  userEmail?: string;
}

const { userEmail = 'admin@mumutech.com' } = Astro.props;

const allItems = await contentRepository.getAllItems();
const workshops = allItems.filter((i) => i.category === 'educativa');
const services = allItems.filter((i) => i.category === 'servicios');
const projects = allItems.filter((i) => i.category === 'cosas-interesantes');
const sections = await contentRepository.getAllSections();
const repairTickets = await contentRepository.getRepairTickets();
const messages = await contentRepository.getContactMessages();

const sectionLabels: Record<string, { label: string; route: string; variant: 'pink' | 'cyan' | 'lime' }> = {
  educativa: { label: 'EDUCATIVA & TALLERES', route: '/educativa', variant: 'pink' },
  servicios: { label: 'SERVICIOS TÉCNICOS & MODS', route: '/servicios', variant: 'cyan' },
  'cosas-interesantes': { label: 'EXPERIMENTOS / COSAS INTERESANTES & DIY', route: '/cosas-interesantes', variant: 'lime' },
};
---

<div class={styles.dashboard} id="admin-dashboard-root" data-active-class={styles.active}>
  <div class={styles.topBar}>
    <div class={styles.userInfo}>
      <span style="color: #39ff14;">●</span>
      <span>SESIÓN ACTIVA: <strong id="user-display-email">{userEmail}</strong></span>
    </div>

    <div style="display: flex; gap: 0.75rem;">
      <Button href="/" variant="secondary" size="sm">
        VER SITIO WEB
      </Button>
      <button type="button" id="admin-logout-btn" class={styles.actionBtn} style="padding: 0.5rem 1rem; border-color: #ff2a85; color: #ff94c2;">
        CERRAR SESIÓN
      </button>
    </div>
  </div>

  <div class={styles.tabs} role="tablist">
    <button type="button" class:list={[styles.tabBtn, styles.active]} data-tab="workshops" role="tab">
      TALLERES ({workshops.length})
    </button>
    <button type="button" class={styles.tabBtn} data-tab="services" role="tab">
      SERVICIOS ({services.length})
    </button>
    <button type="button" class={styles.tabBtn} data-tab="projects" role="tab">
      PROYECTOS DIY ({projects.length})
    </button>
    <button type="button" class={styles.tabBtn} data-tab="sections" role="tab">
      TEXTOS SECCIONES ({sections.length})
    </button>
    <button type="button" class={styles.tabBtn} data-tab="tickets" role="tab">
      TICKETS ({repairTickets.length})
    </button>
    <button type="button" class={styles.tabBtn} data-tab="messages" role="tab">
      MENSAJES ({messages.length})
    </button>
    <button type="button" class={styles.tabBtn} data-tab="create" role="tab" style="color: #39ff14;">
      + NUEVO CONTENIDO
    </button>
  </div>

  <!-- Workshops Panel -->
  <section id="panel-workshops" class:list={[styles.panel, styles.active]} role="tabpanel">
    <h2 style="color: #ffffff; font-size: 1.25rem; font-family: var(--font-mono);">GESTIÓN DE TALLERES EDUCATIVOS</h2>
    <div style="overflow-x: auto;">
      <table class={styles.table}>
        <thead>
          <tr>
            <th scope="col">CÓD</th>
            <th scope="col">TÍTULO</th>
            <th scope="col">ESTADO</th>
            <th scope="col">NIVEL</th>
            <th scope="col">PRECIO</th>
            <th scope="col">ACCIONES</th>
          </tr>
        </thead>
        <tbody>
          {workshops.map((w) => (
            <tr class={w.published ? '' : styles.rowHidden}>
              <td><Badge variant="pink">{w.code}</Badge></td>
              <td>{w.title}</td>
              <td>
                <Badge variant={w.published ? 'lime' : undefined}>
                  {w.published ? 'PUBLICADO' : 'OCULTO'}
                </Badge>
              </td>
              <td>{w.level || 'N/A'}</td>
              <td>${w.price?.toLocaleString('es-CL')} CLP</td>
              <td style="white-space: nowrap;">
                <button
                  type="button"
                  class:list={[styles.actionBtn, w.published ? styles.unpublishBtn : styles.publishBtn]}
                  data-toggle-publish-id={w.id}
                  data-next-published={String(!w.published)}
                >
                  {w.published ? 'OCULTAR' : 'PUBLICAR'}
                </button>
                <button type="button" class:list={[styles.actionBtn, styles.deleteBtn]} data-delete-id={w.id}>
                  ELIMINAR
                </button>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <!-- Services Panel -->
  <section id="panel-services" class={styles.panel} role="tabpanel">
    <h2 style="color: #ffffff; font-size: 1.25rem; font-family: var(--font-mono);">GESTIÓN DE SERVICIOS & REPARACIONES</h2>
    <div style="overflow-x: auto;">
      <table class={styles.table}>
        <thead>
          <tr>
            <th scope="col">CÓD</th>
            <th scope="col">TÍTULO</th>
            <th scope="col">ESTADO</th>
            <th scope="col">TIPO</th>
            <th scope="col">DESDE</th>
            <th scope="col">ACCIONES</th>
          </tr>
        </thead>
        <tbody>
          {services.map((s) => (
            <tr class={s.published ? '' : styles.rowHidden}>
              <td><Badge variant="cyan">{s.code}</Badge></td>
              <td>{s.title}</td>
              <td>
                <Badge variant={s.published ? 'lime' : undefined}>
                  {s.published ? 'PUBLICADO' : 'OCULTO'}
                </Badge>
              </td>
              <td>{s.serviceType || 'Servicio'}</td>
              <td>${s.startingPrice?.toLocaleString('es-CL')} CLP</td>
              <td style="white-space: nowrap;">
                <button
                  type="button"
                  class:list={[styles.actionBtn, s.published ? styles.unpublishBtn : styles.publishBtn]}
                  data-toggle-publish-id={s.id}
                  data-next-published={String(!s.published)}
                >
                  {s.published ? 'OCULTAR' : 'PUBLICAR'}
                </button>
                <button type="button" class:list={[styles.actionBtn, styles.deleteBtn]} data-delete-id={s.id}>
                  ELIMINAR
                </button>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <!-- Projects Panel -->
  <section id="panel-projects" class={styles.panel} role="tabpanel">
    <h2 style="color: #ffffff; font-size: 1.25rem; font-family: var(--font-mono);">GESTIÓN DE COSAS INTERESANTES & DIY</h2>
    <div style="overflow-x: auto;">
      <table class={styles.table}>
        <thead>
          <tr>
            <th scope="col">CÓD</th>
            <th scope="col">TÍTULO</th>
            <th scope="col">ESTADO</th>
            <th scope="col">CATEGORÍA</th>
            <th scope="col">ACCIONES</th>
          </tr>
        </thead>
        <tbody>
          {projects.map((p) => (
            <tr class={p.published ? '' : styles.rowHidden}>
              <td><Badge variant="lime">{p.code}</Badge></td>
              <td>{p.title}</td>
              <td>
                <Badge variant={p.published ? 'lime' : undefined}>
                  {p.published ? 'PUBLICADO' : 'OCULTO'}
                </Badge>
              </td>
              <td>{p.projectType || 'DIY'}</td>
              <td style="white-space: nowrap;">
                <button
                  type="button"
                  class:list={[styles.actionBtn, p.published ? styles.unpublishBtn : styles.publishBtn]}
                  data-toggle-publish-id={p.id}
                  data-next-published={String(!p.published)}
                >
                  {p.published ? 'OCULTAR' : 'PUBLICAR'}
                </button>
                <button type="button" class:list={[styles.actionBtn, styles.deleteBtn]} data-delete-id={p.id}>
                  ELIMINAR
                </button>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <!-- Editable Section Descriptions Panel -->
  <section id="panel-sections" class={styles.panel} role="tabpanel">
    <h2 style="color: #ffffff; font-size: 1.25rem; font-family: var(--font-mono);">
      TEXTOS Y DESCRIPCIONES DE CADA SECCIÓN
    </h2>
    <p style="margin-top: 0.5rem; color: #b4b4ca; font-size: 0.9rem;">
      Edita el título y los párrafos introductorios de Educativa, Servicios y Experimentos/DIY. Los cambios se reflejan de inmediato en el sitio público y se sincronizan con Supabase (`site_sections`) cuando la base de datos está conectada.
    </p>

    <div class={styles.sectionsStack}>
      {sections.map((sec) => {
        const meta = sectionLabels[sec.category];
        const titleInputId = `sec-title-${sec.category}`;
        const descInputId = `sec-desc-${sec.category}`;
        return (
          <form class={styles.sectionEditorCard} data-section-editor-form data-section-category={sec.category}>
            <div class={styles.sectionEditorHeader}>
              <div style="display: flex; align-items: center; gap: 0.65rem; flex-wrap: wrap;">
                <Badge variant={meta?.variant || 'cyan'}>{meta?.label || sec.category}</Badge>
                <a href={meta?.route || '/'} target="_blank" rel="noopener noreferrer" style="font-family: var(--font-mono); font-size: 0.78rem; color: #00f0ff;">
                  Ver en {meta?.route} ↗
                </a>
              </div>
              <span style="font-family: var(--font-mono); font-size: 0.75rem; color: #8f8fa6;">
                Actualizado: {new Date(sec.updatedAt).toLocaleDateString('es-CL')}
              </span>
            </div>

            <div>
              <label for={titleInputId} class={styles.editorFieldLabel}>TÍTULO DE LA SECCIÓN</label>
              <input
                type="text"
                id={titleInputId}
                name="title"
                required
                minlength="3"
                maxlength="140"
                value={sec.title}
                class={styles.editorInput}
              />
            </div>

            <div>
              <label for={descInputId} class={styles.editorFieldLabel}>PÁRRAFOS DESCRIPTIVOS</label>
              <span class={styles.editorFieldHint}>
                Separa cada párrafo dejando una línea en blanco entre ellos.
              </span>
              <textarea
                id={descInputId}
                name="descriptionsText"
                required
                rows="6"
                class={styles.editorTextarea}
              >{sec.descriptions.join('\n\n')}</textarea>
            </div>

            <div class={styles.sectionSaveStatus} data-section-save-status role="status" aria-live="polite"></div>

            <div style="display: flex; justify-content: flex-end;">
              <Button type="submit" variant="primary" size="sm" data-section-save-btn>
                GUARDAR TEXTOS DE SECCIÓN
              </Button>
            </div>
          </form>
        );
      })}
    </div>
  </section>

  <!-- Repair Tickets Panel -->
  <section id="panel-tickets" class={styles.panel} role="tabpanel">
    <h2 style="color: #ffffff; font-size: 1.25rem; font-family: var(--font-mono);">TICKETS DE REPARACIÓN RECIBIDOS</h2>
    {repairTickets.length === 0 ? (
      <p style="margin-top: 1rem; color: #a0a0b5; font-family: var(--font-mono);">No hay tickets de reparación registrados aún.</p>
    ) : (
      <div style="overflow-x: auto;">
        <table class={styles.table}>
          <thead>
            <tr>
              <th scope="col">TICKET</th>
              <th scope="col">FECHA</th>
              <th scope="col">CLIENTE</th>
              <th scope="col">EQUIPO</th>
              <th scope="col">SÍNTOMAS</th>
              <th scope="col">ESTADO</th>
            </tr>
          </thead>
          <tbody>
            {repairTickets.map((t) => (
              <tr>
                <td><Badge variant="lime">{t.ticketNumber}</Badge></td>
                <td>{new Date(t.createdAt).toLocaleDateString('es-CL')}</td>
                <td>
                  <strong>{t.clientName}</strong>
                  <div style="font-size: 0.78rem;"><a href={`mailto:${t.clientEmail}`} style="color: #00f0ff;">{t.clientEmail}</a></div>
                </td>
                <td>{t.equipmentBrandModel}</td>
                <td style="max-width: 300px;">{t.symptomsDescription}</td>
                <td><Badge variant="cyan">{t.status}</Badge></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )}
  </section>

  <!-- Messages Panel -->
  <section id="panel-messages" class={styles.panel} role="tabpanel">
    <h2 style="color: #ffffff; font-size: 1.25rem; font-family: var(--font-mono);">MENSAJES Y CONTACTOS RECIBIDOS</h2>
    {messages.length === 0 ? (
      <p style="margin-top: 1rem; color: #a0a0b5; font-family: var(--font-mono);">No hay mensajes nuevos registrados aún.</p>
    ) : (
      <div style="overflow-x: auto;">
        <table class={styles.table}>
          <thead>
            <tr>
              <th scope="col">FECHA</th>
              <th scope="col">NOMBRE</th>
              <th scope="col">EMAIL</th>
              <th scope="col">INTERÉS</th>
              <th scope="col">MENSAJE</th>
            </tr>
          </thead>
          <tbody>
            {messages.map((m) => (
              <tr>
                <td>{new Date(m.createdAt).toLocaleDateString('es-CL')}</td>
                <td><strong>{m.name}</strong></td>
                <td><a href={`mailto:${m.email}`} style="color: #00f0ff;">{m.email}</a></td>
                <td><Badge>{m.interest}</Badge></td>
                <td style="max-width: 300px;">{m.message}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )}
  </section>

  <!-- Create Content Panel -->
  <section id="panel-create" class={styles.panel} role="tabpanel">
    <h2 style="color: #ffffff; font-size: 1.25rem; font-family: var(--font-mono); margin-bottom: 1.5rem;">
      PUBLICAR NUEVO ITEM (SUPABASE & CLOUDINARY READY)
    </h2>

    <form id="create-content-form" style="display: flex; flex-direction: column; gap: 1rem;">
      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
        <div>
          <label for="create-code" style="font-family: var(--font-mono); font-size: 0.8rem; color: #a0a0b5;">CÓDIGO (3 DÍGITOS)</label>
          <input id="create-code" type="text" name="code" required pattern="[0-9]{3}" placeholder="010" style="width: 100%; padding: 0.6rem; background: #08080c; border: 1px solid #333; color: #fff; font-family: monospace;" />
        </div>
        <div>
          <label for="create-category" style="font-family: var(--font-mono); font-size: 0.8rem; color: #a0a0b5;">SECCIÓN / CATEGORÍA</label>
          <select id="create-category" name="category" style="width: 100%; padding: 0.6rem; background: #08080c; color-scheme: dark; border: 1px solid #333; color: #fff;">
            <option value="educativa">Educativa (Taller)</option>
            <option value="servicios">Servicios (Reparación/Mod)</option>
            <option value="cosas-interesantes">Cosas Interesantes (DIY)</option>
          </select>
        </div>
      </div>

      <div>
        <label for="create-title" style="font-family: var(--font-mono); font-size: 0.8rem; color: #a0a0b5;">TÍTULO</label>
        <input id="create-title" type="text" name="title" required placeholder="Ej: PEDAL DELAY PT2399 DIY" style="width: 100%; padding: 0.6rem; background: #08080c; border: 1px solid #333; color: #fff;" />
      </div>

      <div>
        <label for="create-summary" style="font-family: var(--font-mono); font-size: 0.8rem; color: #a0a0b5;">RESUMEN CORTO</label>
        <input id="create-summary" type="text" name="summary" required placeholder="Descripción concisa para la tarjeta..." style="width: 100%; padding: 0.6rem; background: #08080c; border: 1px solid #333; color: #fff;" />
      </div>

      <div>
        <label for="create-description" style="font-family: var(--font-mono); font-size: 0.8rem; color: #a0a0b5;">DESCRIPCIÓN COMPLETA (UN PÁRRAFO O UN PUNTO POR LÍNEA)</label>
        <textarea id="create-description" name="description" required rows="4" placeholder="Escribe un párrafo continuo o separa cada punto en una línea nueva..." style="width: 100%; padding: 0.6rem; background: #08080c; border: 1px solid #333; color: #fff;"></textarea>
      </div>

      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
        <div>
          <label for="create-hours" style="font-family: var(--font-mono); font-size: 0.8rem; color: #a0a0b5;">HORARIO (OPCIONAL · SOLO TALLERES)</label>
          <input id="create-hours" type="text" name="hours" placeholder="Ej: Sábados de 10:00 a 15:00 hrs" style="width: 100%; padding: 0.6rem; background: #08080c; border: 1px solid #333; color: #fff;" />
        </div>
        <div>
          <label for="create-place" style="font-family: var(--font-mono); font-size: 0.8rem; color: #a0a0b5;">LUGAR (OPCIONAL · SOLO TALLERES)</label>
          <input id="create-place" type="text" name="place" placeholder="Ej: Providencia, Santiago" style="width: 100%; padding: 0.6rem; background: #08080c; border: 1px solid #333; color: #fff;" />
        </div>
      </div>

      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
        <div>
          <label for="create-image-url" style="font-family: var(--font-mono); font-size: 0.8rem; color: #a0a0b5;">RUTA LOCAL (/images/...) O URL DE IMAGEN</label>
          <input id="create-image-url" type="text" name="imageUrl" required value="/images/placeholder.svg" style="width: 100%; padding: 0.6rem; background: #08080c; border: 1px solid #333; color: #fff;" />
        </div>
        <div>
          <label for="create-image-alt" style="font-family: var(--font-mono); font-size: 0.8rem; color: #a0a0b5;">TEXTO ALT IMAGEN</label>
          <input id="create-image-alt" type="text" name="imageAlt" required value="Foto de circuito pedal diy" style="width: 100%; padding: 0.6rem; background: #08080c; border: 1px solid #333; color: #fff;" />
        </div>
      </div>

      <div>
        <label for="create-tags" style="font-family: var(--font-mono); font-size: 0.8rem; color: #a0a0b5;">TAGS (SEPARADOS POR COMA)</label>
        <input id="create-tags" type="text" name="tags" placeholder="Pedales DIY, Delay, PT2399, Audio" style="width: 100%; padding: 0.6rem; background: #08080c; border: 1px solid #333; color: #fff;" />
      </div>

      <label style="display: flex; align-items: center; gap: 0.6rem; font-family: var(--font-mono); font-size: 0.85rem; color: #d6d6e6; cursor: pointer;">
        <input type="checkbox" name="published" value="true" checked style="width: 1.1rem; height: 1.1rem; accent-color: #39ff14;" />
        <span>Publicar inmediatamente en el sitio web (desmarca para dejarlo oculto en el CMS)</span>
      </label>

      <Button type="submit" variant="primary" size="md">
        GUARDAR EN MUMU TECH
      </Button>
    </form>
  </section>
</div>

<script>
  const dashboardRoot = document.getElementById('admin-dashboard-root');
  const activeClass = dashboardRoot?.getAttribute('data-active-class') || 'active';

  // Tab switching logic
  const tabs = document.querySelectorAll('[data-tab]');
  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      const target = tab.getAttribute('data-tab');
      tabs.forEach((t) => t.classList.remove(activeClass));
      tab.classList.add(activeClass);

      document.querySelectorAll('[role="tabpanel"]').forEach((p) => {
        p.classList.remove(activeClass);
      });

      const panel = document.getElementById(`panel-${target}`);
      if (panel) {
        panel.classList.add(activeClass);
      }
    });
  });

  // Logout handler (clears HttpOnly session cookie via server endpoint)
  const logoutBtn = document.getElementById('admin-logout-btn');
  if (logoutBtn) {
    logoutBtn.addEventListener('click', async () => {
      try {
        await fetch('/api/auth', { method: 'DELETE', credentials: 'same-origin' });
      } finally {
        localStorage.removeItem('mumu_admin_token');
        localStorage.removeItem('mumu_admin_user');
        window.location.reload();
      }
    });
  }

  // Toggle publish / unpublish handler (enable or disable item without deleting)
  document.querySelectorAll('[data-toggle-publish-id]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const id = btn.getAttribute('data-toggle-publish-id');
      const nextPublished = btn.getAttribute('data-next-published') === 'true';
      if (!id) return;

      const res = await fetch('/api/content', {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        credentials: 'same-origin',
        body: JSON.stringify({ id, published: nextPublished }),
      });

      if (res.ok) {
        window.location.reload();
      } else {
        alert('No autorizado o error al cambiar el estado de publicación.');
      }
    });
  });

  // Delete handler (authenticated automatically via HttpOnly SameSite=Strict cookie)
  document.querySelectorAll('[data-delete-id]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const id = btn.getAttribute('data-delete-id');
      if (id && confirm('¿Estás seguro de eliminar este elemento?')) {
        const res = await fetch(`/api/content?id=${encodeURIComponent(id)}`, {
          method: 'DELETE',
          credentials: 'same-origin',
        });
        if (res.ok) {
          alert('Elemento eliminado exitosamente');
          window.location.reload();
        } else {
          alert('No autorizado o error al eliminar.');
        }
      }
    });
  });

  // Editable Section Descriptions form handler (PUT /api/sections)
  document.querySelectorAll<HTMLFormElement>('form[data-section-editor-form]').forEach((secForm) => {
    secForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const category = secForm.getAttribute('data-section-category') || '';
      const statusBox = secForm.querySelector<HTMLElement>('[data-section-save-status]');
      const saveBtn = secForm.querySelector<HTMLButtonElement>('[data-section-save-btn]');
      const fd = new FormData(secForm);

      const title = String(fd.get('title') || '').trim();
      const rawText = String(fd.get('descriptionsText') || '');
      const descriptions = rawText
        .split(/\r?\n\s*\r?\n/)
        .map((p) => p.replace(/\s+/g, ' ').trim())
        .filter((p) => p.length > 0);

      if (saveBtn) saveBtn.disabled = true;
      if (statusBox) statusBox.style.display = 'none';

      try {
        const res = await fetch('/api/sections', {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          credentials: 'same-origin',
          body: JSON.stringify({ category, title, descriptions }),
        });

        const result = await res.json();
        if (statusBox) {
          if (res.ok && result.success) {
            statusBox.style.cssText =
              'display:block;background:rgba(57,255,20,0.14);border:1px solid #39ff14;color:#9cff89;';
            statusBox.textContent = '✓ Textos guardados y actualizados en el sitio público.';
          } else {
            statusBox.style.cssText =
              'display:block;background:rgba(255,42,133,0.15);border:1px solid #ff2a85;color:#ff9ec7;';
            statusBox.textContent = '⚠ ' + (result.error || 'Error al guardar la sección.');
          }
        }
      } catch {
        if (statusBox) {
          statusBox.style.cssText =
            'display:block;background:rgba(255,42,133,0.15);border:1px solid #ff2a85;color:#ff9ec7;';
          statusBox.textContent = '⚠ Error de conexión con la API.';
        }
      } finally {
        if (saveBtn) saveBtn.disabled = false;
      }
    });
  });

  // Create form handler (authenticated automatically via HttpOnly SameSite=Strict cookie)
  const createForm = document.getElementById('create-content-form') as HTMLFormElement | null;
  if (createForm) {
    createForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const formData = new FormData(createForm);

      const tagsRaw = (formData.get('tags') as string) || '';
      const tags = tagsRaw.split(',').map((t) => t.trim()).filter(Boolean);

      const title = formData.get('title') as string;
      const slug = title.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');

      const rawDesc = String(formData.get('description') || '').trim();
      const descLines = rawDesc
        .split(/\r?\n/)
        .map((line) => line.replace(/^\s*[-•*]\s*/, '').trim())
        .filter(Boolean);
      const descriptionPayload = descLines.length > 1 ? descLines : rawDesc;

      const category = String(formData.get('category') || 'educativa');
      const hours = String(formData.get('hours') || '').trim();
      const place = String(formData.get('place') || '').trim();

      const payload: Record<string, unknown> = {
        id: `item-${Date.now()}`,
        code: formData.get('code'),
        title: title,
        slug: slug || `item-${Date.now()}`,
        summary: formData.get('summary'),
        description: descriptionPayload,
        category,
        imageUrl: formData.get('imageUrl'),
        imageAlt: formData.get('imageAlt'),
        tags: tags,
        featured: formData.get('published') === 'true',
        published: formData.get('published') === 'true',
      };

      if (category === 'educativa') {
        if (hours) payload.hours = hours;
        if (place) payload.place = place;
      }

      try {
        const res = await fetch('/api/content', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          credentials: 'same-origin',
          body: JSON.stringify(payload),
        });

        const result = await res.json();
        if (res.ok && result.success) {
          alert('¡Elemento creado y publicado con éxito!');
          window.location.reload();
        } else {
          alert('Error al guardar: ' + (result.error || 'Datos inválidos'));
        }
      } catch {
        alert('Error al conectar con la API');
      }
    });
  }
</script>
