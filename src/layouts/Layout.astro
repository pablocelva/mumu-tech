---
import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import type { SeoMetadataProps } from '../lib/seo';
import '../styles/global.css';

interface Props extends SeoMetadataProps {
  structuredData?: Record<string, unknown>;
  hideHeader?: boolean;
  hideFooter?: boolean;
}

const {
  title,
  description,
  canonical,
  image,
  type,
  structuredData,
  hideHeader = false,
  hideFooter = false,
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <SEO
      title={title}
      description={description}
      canonical={canonical}
      image={image}
      type={type}
      structuredData={structuredData}
    />
  </head>
  <body>
    <!-- Retro Analog Glitch & Chromatic Background Layer -->
    <div class="lofi-background" aria-hidden="true"></div>
    <div class="lofi-overlay" aria-hidden="true"></div>

    {!hideHeader && <Header />}

    <main id="main-content" style="flex: 1; display: flex; flex-direction: column;">
      <slot />
    </main>

    {!hideFooter && <Footer />}
  </body>
</html>
