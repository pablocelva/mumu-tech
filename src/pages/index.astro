---
import Layout from '../layouts/Layout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import Button from '../components/Button.astro';
import Badge from '../components/Badge.astro';
import { contentRepository } from '../repositories/content.repository';

const featuredWorkshops = await contentRepository.getItemsByCategory('educativa');
const featuredServices = await contentRepository.getItemsByCategory('servicios');
const featuredProjects = await contentRepository.getItemsByCategory('cosas-interesantes');

const sectionsOverview = [
  {
    title: 'EDUCATIVA & TALLERES',
    description: 'Aprende electrónica práctica construyendo tus propios pedales de efectos de guitarra, sintetizadores de ruido analógicos y dominando el arte de la soldadura.',
    href: '/educativa',
    imageUrl: 'https://plus.unsplash.com/premium_photo-1723867360557-5cf397665890?w=600&auto=format&fit=crop&q=60&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxzZWFyY2h8MXx8dGFsbGVyJTIwZWxlY3Ryb25pY2F8ZW58MHx8MHx8fDA%3D',
    imageAlt: 'Taller de pedales de guitarra DIY',
    badge: 'TALLERES DIY',
    variant: 'pink' as const,
  },
  {
    title: 'SERVICIOS TÉCNICOS & MODS',
    description: 'Reparación especializada, calibración de bias, cambio de switches true-bypass y modificaciones audiófilas de circuito para pedales y amplificadores.',
    href: '/servicios',
    imageUrl: 'https://images.unsplash.com/photo-1751887687425-64b20d82f344?q=80&w=1074&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D',
    imageAlt: 'Reparación de circuitos de audio y pedales',
    badge: 'REPARACIONES',
    variant: 'cyan' as const,
  },
  {
    title: 'COSAS INTERESANTES & DIY',
    description: 'Bitácora de experimentos libres, video sintetizadores analógicos, modificaciones de cassette tapes, circuit bending y guías de construcción.',
    href: '/cosas-interesantes',
    imageUrl: 'https://images.unsplash.com/photo-1550751827-4bd374c3f58b?auto=format&fit=crop&w=800&q=80',
    imageAlt: 'Video sintetizador glitch analógico',
    badge: 'EXPERIMENTOS',
    variant: 'lime' as const,
  },
];
---

<Layout
  title="Mumu Tech | Taller de Electrónica DIY, Pedales y Reparaciones"
  description="Laboratorio técnico independiente: talleres de pedales de guitarra, sintetizadores, reparaciones de audio y modificaciones analógicas."
>
  <div class="container" style="max-width: 1100px; margin: 0 auto; padding: 0 1.5rem 4rem 1.5rem;">
    
    <!-- Hero / Intro Section Header -->
    <SectionHeader
      title="MUMU TECH"
      descriptions={[
        "¡Bienvenido a Mumu Tech! Un espacio dedicado a la electrónica analógica artesanal, la creación de pedales de guitarra, modificaciones de equipos de audio, rescate de tecnología vintage y experimentación sonora.",
        "Aquí encontrarás talleres prácticos donde ensamblas tus propios artefactos desde cero, servicios técnicos especializados para revivir o potenciar tus pedales y amplificadores, y una bitácora abierta de proyectos lo-fi entretenidos."
      ]}
    >
      <div style="display: flex; gap: 1rem; justify-content: center; margin-top: 2rem; flex-wrap: wrap;">
        <Button href="/educativa" variant="accentPink" size="lg">
          VER PRÓXIMOS TALLERES
        </Button>
        <Button href="/contacto" variant="secondary" size="lg">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true" style="flex-shrink: 0; margin-right: 0.35rem;">
            <path d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/>
          </svg>
          CONTACTAR / COTIZAR
        </Button>
      </div>
    </SectionHeader>

    <hr class="retroDivider" style="width: 100%; height: 1px; background: rgba(255, 255, 255, 0.2); border: none; margin: 3rem 0;" />

    <!-- Main Section Cards Summary -->
    <section aria-labelledby="secciones-principales">
      <div style="text-align: center; margin-bottom: 2.5rem;">
        <h2 id="secciones-principales" style="font-family: var(--font-mono); font-size: 1.3rem; color: #00f0ff; letter-spacing: 0.08em; text-transform: uppercase;">
          [ EXPLORAR EL TALLER ]
        </h2>
        <p style="color: #c4c4d4; font-size: 0.95rem; margin-top: 0.4rem;">
          Conoce nuestras tres áreas de trabajo y proyectos activos
        </p>
      </div>

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 2rem;">
        {sectionsOverview.map((sec) => (
          <article style="background: rgba(18, 18, 26, 0.82); backdrop-filter: blur(14px); border: 1px solid rgba(255, 255, 255, 0.14); border-radius: 2px; overflow: hidden; display: flex; flex-direction: column; transition: all 0.2s ease; box-shadow: 0 8px 30px rgba(0,0,0,0.4);">
            <div style="height: 200px; overflow: hidden; background: #000;">
              <img
                src={sec.imageUrl}
                alt={sec.imageAlt}
                loading="lazy"
                width="800"
                height="450"
                style="width: 100%; height: 100%; object-fit: cover; filter: contrast(105%) brightness(95%);"
                onerror="this.onerror=null; this.src='/images/placeholder.svg';"
              />
            </div>
            <div style="padding: 1.75rem; display: flex; flex-direction: column; justify-content: space-between; flex: 1;">
              <div>
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem;">
                  <Badge variant={sec.variant}>{sec.badge}</Badge>
                </div>
                <h3 style="font-family: system-ui, sans-serif; font-size: 1.25rem; font-weight: 800; color: #ffffff; text-transform: uppercase; margin-bottom: 0.75rem; line-height: 1.2;">
                  {sec.title}
                </h3>
                <p style="color: #d6d6e6; font-size: 0.92rem; line-height: 1.6; margin-bottom: 1.5rem;">
                  {sec.description}
                </p>
              </div>

              <Button href={sec.href} variant="primary" fullWidth size="md">
                IR A {sec.title.split('&')[0].trim()} →
              </Button>
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- Quick Highlights Banner -->
    <section style="margin-top: 4.5rem; background: rgba(15, 15, 20, 0.85); backdrop-filter: blur(12px); border: 1px solid rgba(0, 240, 255, 0.3); border-radius: 2px; padding: 2.5rem; text-align: center; box-shadow: 0 0 30px rgba(0, 240, 255, 0.1);">
      <h2 style="font-family: system-ui, sans-serif; font-size: 1.6rem; font-weight: 800; text-transform: uppercase; color: #ffffff; margin-bottom: 1rem;">
        ¿TIENES UN EQUIPO CON FALLAS O UN PROYECTO EN MENTE?
      </h2>
      <p style="color: #d0d0e2; font-size: 1rem; max-width: 650px; margin: 0 auto 1.75rem auto; line-height: 1.6;">
        Hablemos directamente por WhatsApp o correo. Cuéntame sobre el sonido que buscas, el pedal que quieres modificar o reserva tu cupo para el próximo taller presencial.
      </p>
      <div style="display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap;">
        <Button href="https://wa.me/56900000000" target="_blank" rel="noopener noreferrer" variant="accentPink" size="md">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true" style="flex-shrink: 0; margin-right: 0.35rem;">
            <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.816 9.816 0 0012.04 2zm0 18.15c-1.49 0-2.96-.4-4.24-1.16l-.3-.18-3.12.82.83-3.04-.2-.31a8.12 8.12 0 01-1.25-4.37c0-4.49 3.65-8.14 8.15-8.14 2.18 0 4.22.85 5.76 2.39 1.54 1.54 2.39 3.58 2.39 5.76 0 4.49-3.66 8.14-8.15 8.14zm4.47-6.1c-.24-.12-1.45-.72-1.67-.8-.23-.08-.39-.12-.56.12-.17.24-.64.8-.79.96-.14.16-.29.18-.53.06-.24-.12-1.03-.38-1.96-1.21-.72-.64-1.21-1.44-1.35-1.68-.14-.24-.01-.37.11-.49.11-.11.24-.29.37-.43.12-.15.16-.24.24-.41.08-.17.04-.31-.02-.43s-.56-1.34-.76-1.84c-.2-.48-.41-.42-.56-.43h-.48c-.16 0-.43.06-.66.31-.22.24-.87.85-.87 2.07s.89 2.4 1.01 2.56c.12.17 1.75 2.67 4.23 3.74.59.26 1.05.41 1.41.53.59.19 1.13.16 1.56.1.48-.07 1.45-.59 1.66-1.16.2-.57.2-1.06.14-1.16-.06-.11-.22-.17-.46-.29z"/>
          </svg>
          WHATSAPP DIRECTO
        </Button>
        <Button href="/contacto" variant="secondary" size="md">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true" style="flex-shrink: 0; margin-right: 0.35rem;">
            <path d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/>
          </svg>
          FORMULARIO & CORREO
        </Button>
      </div>
    </section>

  </div>
</Layout>
