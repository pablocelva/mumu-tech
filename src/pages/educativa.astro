---
import Layout from '../layouts/Layout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import Card from '../components/Card.astro';
import { contentRepository } from '../repositories/content.repository';

const workshops = await contentRepository.getItemsByCategory('educativa');
---

<Layout
  title="Educativa & Talleres DIY | Mumu Tech"
  description="Talleres presenciales y guías de electrónica analógica para audio: construcción de pedales de guitarra Fuzz, sintetizadores CMOS y soldadura práctica."
>
  <div class="container" style="max-width: 1100px; margin: 0 auto; padding: 0 1.5rem 4rem 1.5rem;">
    
    <SectionHeader
      title="TALLERES EDUCATIVOS"
      descriptions={[
        "En esta sección encontrarás nuestros talleres prácticos donde construyes tus propios instrumentos y efectos de audio desde cero. No necesitas experiencia previa en electrónica ni ingeniería para comenzar: te enseñamos desde cómo tomar el cautín hasta cómo entender el flujo de la señal de audio.",
        "Todos los talleres incluyen los componentes electrónicos seleccionados (transistores vintage, potenciómetros Alpha, jacks Neutrik, gabinetes de aluminio perforados) y te llevas a casa tu pedal o sintetizador 100% funcional y terminado.",
        "Los cupos son reducidos (máximo 8 a 10 personas por sesión) para garantizar una atención personalizada en cada banco de trabajo."
      ]}
    />

    <hr class="retroDivider" style="width: 100%; height: 1px; background: rgba(255, 255, 255, 0.2); border: none; margin: 2.5rem 0;" />

    <section aria-label="Listado de Talleres Disponibles">
      {workshops.map((workshop) => (
        <Card
          item={workshop}
          ctaText="RESERVAR CUPO / CONSULTAR"
          ctaHref={`/contacto?interest=taller&item=${encodeURIComponent(workshop.title)}`}
        />
      ))}
    </section>

  </div>
</Layout>
