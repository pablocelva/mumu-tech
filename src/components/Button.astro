---
import styles from './Button.module.css';

interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'outline' | 'accentPink';
  size?: 'sm' | 'md' | 'lg';
  fullWidth?: boolean;
  type?: 'button' | 'submit' | 'reset';
  class?: string;
  id?: string;
  target?: string;
  rel?: string;
  [key: string]: any;
}

const {
  href,
  variant = 'primary',
  size = 'md',
  fullWidth = false,
  type = 'button',
  class: className = '',
  id,
  target,
  rel,
  ...rest
} = Astro.props;

const classNames = [
  styles.button,
  styles[variant],
  size !== 'md' ? styles[size] : '',
  fullWidth ? styles.fullWidth : '',
  className,
].filter(Boolean).join(' ');
---

{
  href ? (
    <a href={href} class={classNames} id={id} target={target} rel={rel} {...rest}>
      <slot />
    </a>
  ) : (
    <button type={type} class={classNames} id={id} {...rest}>
      <slot />
    </button>
  )
}
