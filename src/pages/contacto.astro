---
import Layout from '../layouts/Layout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import ContactChannels from '../components/ContactChannels.astro';
import NewsletterForm from '../components/NewsletterForm.astro';
import ContactForm from '../components/ContactForm.astro';

const searchParams = Astro.url.searchParams;
const interestParam = searchParams.get('interest') || 'taller';
---

<Layout
  title="Contacto & Conectividad | Mumu Tech"
  description="Contáctanos vía WhatsApp directo, correo con portapapeles, Instagram, suscríbete al newsletter o envíanos un formulario para talleres y reparaciones."
>
  <div class="container" style="padding-bottom: 4rem;">
    
    <SectionHeader
      title="HABLEMOS Y HAGAMOS COSAS"
      descriptions={[
        "¿Tienes una idea para un pedal personalizado, necesitas reparar tu equipo o quieres reservar tu cupo para los próximos talleres de electrónica? Elige tu canal favorito, suscríbete a nuestras novedades o déjame un mensaje directo a continuación.",
      ]}
    />

    <!-- Unified Direct Contact & Social Channels Component -->
    <ContactChannels />

    <!-- 1. Dedicated Fast Newsletter Section -->
    <div style="max-width: 750px; margin: 0 auto; width: 100%;">
      <NewsletterForm />
    </div>

    <hr class="retroDivider" />

    <!-- 2. Full Contact / Inquiry Form Section -->
    <div style="max-width: 750px; margin: 0 auto; width: 100%;">
      <div style="text-align: center; margin-bottom: 2rem;">
        <span style="font-family: var(--font-mono); font-size: 0.8rem; color: #00f0ff; font-weight: 700;">[ CONSULTAS TÉCNICAS & COTIZACIÓN ]</span>
        <h2 style="font-family: system-ui, sans-serif; font-size: clamp(1.2rem, 4vw, 1.5rem); font-weight: 800; color: #ffffff; text-transform: uppercase; margin-top: 0.4rem; word-break: break-word;">
          FORMULARIO DE CONTACTO & MENSAJE DIRECTO
        </h2>
        <p style="color: #a6a6b8; font-size: 0.92rem; margin-top: 0.3rem;">
          ¿Buscas reparar un equipo o reservar cupo? Escribe tus datos y te responderemos en menos de 24 horas.
        </p>
      </div>

      <ContactForm initialInterest={interestParam} />
    </div>

  </div>
</Layout>
