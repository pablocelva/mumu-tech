---
import Layout from '../layouts/Layout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import Card from '../components/Card.astro';
import SectionTagFilter from '../components/SectionTagFilter.astro';
import { contentRepository } from '../repositories/content.repository';

export const prerender = false;

const [sectionContent, projects] = await Promise.all([
  contentRepository.getSectionContent('cosas-interesantes'),
  contentRepository.getItemsByCategory('cosas-interesantes'),
]);
---

<Layout
  title="Cosas Interesantes & DIY | Mumu Tech"
  description="Proyectos DIY, video sintetizadores analógicos, circuit bending, modificaciones de cinta magnética y experimentos de audio lo-fi."
>
  <div class="container" style="max-width: 1100px; margin: 0 auto; padding: 0 1.5rem 4rem 1.5rem;">
    
    <SectionHeader
      title={sectionContent.title}
      descriptions={sectionContent.descriptions}
    />

    <hr class="retroDivider" style="width: 100%; height: 1px; background: rgba(255, 255, 255, 0.2); border: none; margin: 2.5rem 0;" />

    <SectionTagFilter ariaLabel="Filtrar proyectos DIY por etiqueta">
      {projects.map((project, idx) => (
        <Card
          item={project}
          ctaText="VER DETALLES / GUÍA"
          ctaHref={`/contacto?interest=proyecto&item=${encodeURIComponent(project.title)}`}
          priority={idx === 0}
          eager={idx < 2}
        />
      ))}
    </SectionTagFilter>

  </div>
</Layout>
