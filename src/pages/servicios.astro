---
import Layout from '../layouts/Layout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import Card from '../components/Card.astro';
import SectionTagFilter from '../components/SectionTagFilter.astro';
import { contentRepository } from '../repositories/content.repository';

export const prerender = false;

const sectionContent = await contentRepository.getSectionContent('servicios');
const services = await contentRepository.getItemsByCategory('servicios');
---

<Layout
  title="Servicios Técnicos & Modificaciones | Mumu Tech"
  description="Servicio técnico especializado en pedales de guitarra, amplificadores valvulares, cambio de switches true bypass y modificaciones sonoras a medida."
>
  <div class="container" style="max-width: 1100px; margin: 0 auto; padding: 0 1.5rem 4rem 1.5rem;">
    
    <SectionHeader
      title={sectionContent.title}
      descriptions={sectionContent.descriptions}
    />

    <hr class="retroDivider" style="width: 100%; height: 1px; background: rgba(255, 255, 255, 0.2); border: none; margin: 2.5rem 0;" />

    <SectionTagFilter ariaLabel="Filtrar servicios técnicos por etiqueta">
      {services.map((service) => (
        <Card
          item={service}
          ctaText="ABRIR TICKET / VER DETALLES →"
          ctaHref={`/servicios/${service.slug}`}
        />
      ))}
    </SectionTagFilter>

  </div>
</Layout>
