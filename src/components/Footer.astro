---
import styles from './Footer.module.css';
---

<footer class={styles.footer}>
  <div class="container" style="max-width: 1100px; margin: 0 auto; padding: 0 1.5rem;">
    <div class={styles.grid}>
      <div class={styles.brandCol}>
        <span class={styles.logo}>MUMU TECH</span>
        <p class={styles.tagline}>
          Laboratorio de electrónica DIY, pedales de guitarra, experimentación analógica, reparaciones y talleres prácticos.
        </p>
      </div>

      <div>
        <h2 class={styles.colTitle}>Secciones</h2>
        <ul class={styles.linkList}>
          <li class={styles.linkItem}><a href="/educativa">Talleres & Educación</a></li>
          <li class={styles.linkItem}><a href="/servicios">Servicio Técnico & Mods</a></li>
          <li class={styles.linkItem}><a href="/cosas-interesantes">Cosas Interesantes & DIY</a></li>
          <li class={styles.linkItem}><a href="/contacto">Contacto & Mailing</a></li>
          <li class={styles.linkItem}><a href="/admin">Acceso Privado Admin</a></li>
        </ul>
      </div>

      <div>
        <h2 class={styles.colTitle}>Plataformas & Contacto</h2>
        <div class={styles.socialBadges}>
          <a
            href="https://wa.me/56900000000?text=Hola%20Mumu%20Tech,%20tengo%20una%20consulta%20sobre:"
            target="_blank"
            rel="noopener noreferrer"
            class={styles.socialBtn}
            aria-label="Contactar por WhatsApp"
          >
            💬 WHATSAPP
          </a>
          <a
            href="https://instagram.com/mumutech"
            target="_blank"
            rel="noopener noreferrer"
            class={styles.socialBtn}
            aria-label="Seguir en Instagram"
          >
            📸 INSTAGRAM
          </a>
          <a
            href="https://github.com/mumutech"
            target="_blank"
            rel="noopener noreferrer"
            class={styles.socialBtn}
            aria-label="Ver proyectos en GitHub"
          >
            ⚡ GITHUB
          </a>
        </div>
      </div>
    </div>

    <div class={styles.bottomBar}>
      <span>© {new Date().getFullYear()} MUMU TECH. TODOS LOS DERECHOS RESERVADOS.</span>
      <span>RETRO ANALOG DIY AESTHETICS</span>
    </div>
  </div>
</footer>
