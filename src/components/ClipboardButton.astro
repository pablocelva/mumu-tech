---
import styles from './ClipboardButton.module.css';
import Button from './Button.astro';

interface Props {
  textToCopy: string;
  label?: string;
  successMessage?: string;
  fullWidth?: boolean;
  size?: 'sm' | 'md' | 'lg';
  variant?: 'primary' | 'secondary' | 'outline' | 'accentPink';
}

const {
  textToCopy,
  label = 'COPIAR CORREO',
  successMessage = '¡COPIADO AL PORTAPAPELES!',
  fullWidth = false,
  size = 'md',
  variant = 'secondary',
} = Astro.props;

const buttonId = `clipboard-btn-${Math.random().toString(36).substring(2, 8)}`;
---

<div
  class:list={[styles.wrapper, { [styles.wrapperFullWidth]: fullWidth }]}
  data-clipboard-root
  data-visible-class={styles.visible}
>
  <Button
    type="button"
    id={buttonId}
    variant={variant}
    size={size}
    fullWidth={fullWidth}
    data-copy={textToCopy}
    data-clipboard-btn
    aria-label={`${label}: ${textToCopy}`}
  >
    <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true" style="flex-shrink: 0; margin-right: 0.35rem;">
      <path d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/>
    </svg>
    <span>{label}</span>
  </Button>
  <span id={`${buttonId}-tooltip`} class={styles.tooltip} data-clipboard-tooltip role="status" aria-live="polite">
    {successMessage}
  </span>
</div>

<script>
  function setupClipboardButtons() {
    document.querySelectorAll<HTMLElement>('[data-clipboard-root]').forEach((root) => {
      if (root.dataset.bound === 'true') return;
      root.dataset.bound = 'true';

      const btn = root.querySelector<HTMLButtonElement>('[data-clipboard-btn]');
      const tooltip = root.querySelector<HTMLElement>('[data-clipboard-tooltip]');
      const visibleClass = root.dataset.visibleClass || 'visible';

      if (!btn || !tooltip) return;

      btn.addEventListener('click', async () => {
        const text = btn.getAttribute('data-copy');
        if (!text) return;
        try {
          if (navigator.clipboard) {
            await navigator.clipboard.writeText(text);
          } else {
            const textarea = document.createElement('textarea');
            textarea.value = text;
            document.body.appendChild(textarea);
            textarea.select();
            document.execCommand('copy');
            document.body.removeChild(textarea);
          }
          tooltip.classList.add(visibleClass);
          setTimeout(() => {
            tooltip.classList.remove(visibleClass);
          }, 2500);
        } catch (err) {
          console.error('Copy failed:', err);
        }
      });
    });
  }

  setupClipboardButtons();
  document.addEventListener('astro:page-load', setupClipboardButtons);
</script>
