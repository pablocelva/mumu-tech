# Supabase Configuration (Optional in dev - required in production)
PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Admin Authorization (Comma-separated list of authorized Supabase emails)
ADMIN_ALLOWED_EMAILS=admin@mumutech.com
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-hex-characters

# Cloudinary Configuration
PUBLIC_CLOUDINARY_CLOUD_NAME=mumu-tech
CLOUDINARY_API_KEY=your-cloudinary-key
CLOUDINARY_API_SECRET=your-cloudinary-secret

# Resend Transactional Emails
RESEND_API_KEY=re_your_resend_api_key
