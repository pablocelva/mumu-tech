---
import styles from './Header.module.css';

interface Props {
  currentPath?: string;
}

const { currentPath = Astro.url.pathname } = Astro.props;

const navItems = [
  { label: 'HOME', href: '/' },
  { label: 'EDUCATIVA', href: '/educativa' },
  { label: 'SERVICIOS', href: '/servicios' },
  { label: 'COSAS INTERESANTES', href: '/cosas-interesantes' },
  { label: 'CONTACTO', href: '/contacto' },
];

const isActive = (href: string) => {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
};
---

<header class={styles.header}>
  <div class="container" style="max-width: 1100px; margin: 0 auto; padding: 0 1.5rem;">
    <div class={styles.inner}>
      <a href="/" class={styles.logo} aria-label="Mumu Tech Inicio">
        MUMU TECH
      </a>

      <nav class={styles.nav} aria-label="Navegación principal">
        {navItems.map((item) => (
          <a
            href={item.href}
            class:list={[styles.navLink, { [styles.active]: isActive(item.href) }]}
            aria-current={isActive(item.href) ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))}
        <a href="/admin" class={styles.adminBadge} aria-label="Panel Admin">
          ADMIN
        </a>
      </nav>
    </div>
  </div>
</header>
