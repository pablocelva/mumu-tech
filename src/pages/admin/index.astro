---
import Layout from '../../layouts/Layout.astro';
import AdminLoginForm from '../../components/admin/AdminLoginForm.astro';
import AdminDashboard from '../../components/admin/AdminDashboard.astro';
import { authRepository } from '../../repositories/auth.repository';
import { extractSessionToken } from '../../lib/security';

export const prerender = false;

Astro.response.headers.set('Cache-Control', 'no-store, private');

const sessionToken = extractSessionToken(Astro.request);
const adminUser = sessionToken ? await authRepository.verifyToken(sessionToken) : null;
---

<Layout
  title="Admin Panel | Mumu Tech"
  description="Panel privado de administración de Mumu Tech."
  robots="noindex, nofollow"
  hideFooter={true}
>
  <div class="container" style="max-width: 1100px; margin: 0 auto; padding: 2rem 1.5rem;">
    {
      adminUser ? (
        <AdminDashboard userEmail={adminUser.email} />
      ) : (
        <AdminLoginForm showDemoHint={Boolean(import.meta.env.DEV)} />
      )
    }
  </div>
</Layout>
