---
import styles from './ClipboardButton.module.css';
import Button from './Button.astro';

interface Props {
  textToCopy: string;
  label?: string;
  successMessage?: string;
  fullWidth?: boolean;
  size?: 'sm' | 'md' | 'lg';
  variant?: 'primary' | 'secondary' | 'outline' | 'accentPink';
}

const {
  textToCopy,
  label = 'COPIAR CORREO',
  successMessage = '¡COPIADO AL PORTAPAPELES!',
  fullWidth = false,
  size = 'md',
  variant = 'secondary',
} = Astro.props;

const buttonId = `clipboard-btn-${Math.random().toString(36).substring(2, 8)}`;
---

<div class:list={[styles.wrapper, { [styles.wrapperFullWidth]: fullWidth }]}>
  <Button
    type="button"
    id={buttonId}
    variant={variant}
    size={size}
    fullWidth={fullWidth}
    data-copy={textToCopy}
    aria-label={`${label}: ${textToCopy}`}
  >
    <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true" style="flex-shrink: 0; margin-right: 0.35rem;">
      <path d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/>
    </svg>
    <span>{label}</span>
  </Button>
  <span id={`${buttonId}-tooltip`} class={styles.tooltip} role="status" aria-live="polite">
    {successMessage}
  </span>
</div>

<script define:vars={{ buttonId }}>
  const btn = document.getElementById(buttonId);
  const tooltip = document.getElementById(`${buttonId}-tooltip`);

  if (btn && tooltip) {
    btn.addEventListener('click', async () => {
      const text = btn.getAttribute('data-copy');
      if (text) {
        try {
          if (navigator.clipboard) {
            await navigator.clipboard.writeText(text);
          } else {
            const textarea = document.createElement('textarea');
            textarea.value = text;
            document.body.appendChild(textarea);
            textarea.select();
            document.execCommand('copy');
            document.body.removeChild(textarea);
          }
          tooltip.classList.add(styles.visible || 'visible');
          setTimeout(() => {
            tooltip.classList.remove(styles.visible || 'visible');
          }, 2500);
        } catch (err) {
          console.error('Copy failed:', err);
        }
      }
    });
  }
</script>
