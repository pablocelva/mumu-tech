---
import styles from './Footer.module.css';
---

<footer class={styles.footer}>
  <div class="container" style="max-width: 1100px; margin: 0 auto; padding: 0 1.5rem;">
    <div class={styles.grid}>
      <div class={styles.brandCol}>
        <span class={styles.logo}>MUMU TECH</span>
        <p class={styles.tagline}>
          Laboratorio de electrónica DIY, pedales de guitarra, experimentación analógica, reparaciones y talleres prácticos.
        </p>
      </div>

      <div>
        <h2 class={styles.colTitle}>Secciones</h2>
        <ul class={styles.linkList}>
          <li class={styles.linkItem}><a href="/educativa">Talleres & Educación</a></li>
          <li class={styles.linkItem}><a href="/servicios">Servicio Técnico & Mods</a></li>
          <li class={styles.linkItem}><a href="/cosas-interesantes">Cosas Interesantes & DIY</a></li>
          <li class={styles.linkItem}><a href="/contacto">Contacto & Mailing</a></li>
        </ul>
      </div>

      <div>
        <h2 class={styles.colTitle}>Plataformas & Contacto</h2>
        <div class={styles.socialBadges}>
          <a
            href="https://wa.me/56900000000?text=Hola%20Mumu%20Tech,%20tengo%20una%20consulta%20sobre:"
            target="_blank"
            rel="noopener noreferrer"
            class={styles.socialBtn}
            aria-label="Contactar por WhatsApp"
          >
            <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true" style="flex-shrink: 0;">
              <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.816 9.816 0 0012.04 2zm0 18.15c-1.49 0-2.96-.4-4.24-1.16l-.3-.18-3.12.82.83-3.04-.2-.31a8.12 8.12 0 01-1.25-4.37c0-4.49 3.65-8.14 8.15-8.14 2.18 0 4.22.85 5.76 2.39 1.54 1.54 2.39 3.58 2.39 5.76 0 4.49-3.66 8.14-8.15 8.14zm4.47-6.1c-.24-.12-1.45-.72-1.67-.8-.23-.08-.39-.12-.56.12-.17.24-.64.8-.79.96-.14.16-.29.18-.53.06-.24-.12-1.03-.38-1.96-1.21-.72-.64-1.21-1.44-1.35-1.68-.14-.24-.01-.37.11-.49.11-.11.24-.29.37-.43.12-.15.16-.24.24-.41.08-.17.04-.31-.02-.43s-.56-1.34-.76-1.84c-.2-.48-.41-.42-.56-.43h-.48c-.16 0-.43.06-.66.31-.22.24-.87.85-.87 2.07s.89 2.4 1.01 2.56c.12.17 1.75 2.67 4.23 3.74.59.26 1.05.41 1.41.53.59.19 1.13.16 1.56.1.48-.07 1.45-.59 1.66-1.16.2-.57.2-1.06.14-1.16-.06-.11-.22-.17-.46-.29z"/>
            </svg>
            <span>WHATSAPP</span>
          </a>
          <a
            href="https://www.instagram.com/mumupedals/"
            target="_blank"
            rel="noopener noreferrer"
            class={styles.socialBtn}
            aria-label="Seguir en Instagram"
          >
            <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true" style="flex-shrink: 0;">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
            </svg>
            <span>INSTAGRAM</span>
          </a>
        </div>
      </div>
    </div>

    <div class={styles.bottomBar}>
      <span>© {new Date().getFullYear()} MUMU TECH. TODOS LOS DERECHOS RESERVADOS.</span>
      <span>DEVELOPED BY CELVADEV</span>
    </div>
  </div>
